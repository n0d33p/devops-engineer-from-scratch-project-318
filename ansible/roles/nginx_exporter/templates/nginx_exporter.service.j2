[Unit]
Description=NGINX Prometheus Exporter
After=network-online.target nginx.service
Wants=network-online.target

[Service]
User=nginx_exporter
Group=nginx_exporter
Type=simple
ExecStart=/usr/local/bin/nginx-prometheus-exporter \
  --web.listen-address={{ ansible_default_ipv4.address }}:{{ nginx_exporter_port }} \
  --nginx.scrape-uri=http://127.0.0.1:{{ nginx_stub_status_port }}/stub_status
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
