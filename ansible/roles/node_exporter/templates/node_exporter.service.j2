[Unit]
Description=Prometheus Node Exporter
After=network-online.target
Wants=network-online.target

[Service]
User=node_exporter
Group=node_exporter
Type=simple
ExecStart=/usr/local/bin/node_exporter \
  --web.listen-address={{ ansible_default_ipv4.address }}:{{ node_exporter_port }} \
  --collector.systemd \
  --collector.systemd.unit-include=(docker|nginx|ssh|node_exporter).service \
  --collector.processes
Restart=on-failure

[Install]
WantedBy=multi-user.target