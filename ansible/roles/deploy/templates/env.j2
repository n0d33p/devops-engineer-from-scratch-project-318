SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://{{ db_host }}:{{ db_port }}/{{ db_name }}?sslmode=require
SPRING_DATASOURCE_USERNAME={{ db_user }}
SPRING_DATASOURCE_PASSWORD={{ vault_db_password }}

MANAGEMENT_SERVER_PORT={{ app_management_port }}
JAVA_OPTS=-Xms256m -Xmx512m -Dlogging.file.name=/app/logs/app.log

STORAGE_S3_BUCKET={{ s3_bucket_name }}
STORAGE_S3_REGION={{ s3_region }}
STORAGE_S3_ENDPOINT={{ s3_endpoint }}
STORAGE_S3_ACCESSKEY={{ vault_s3_access_key }}
STORAGE_S3_SECRETKEY={{ vault_s3_secret_key }}