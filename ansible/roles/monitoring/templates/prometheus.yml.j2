global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
{% for job in prometheus_scrape_jobs %}
  - job_name: "{{ job.name }}"
{% if job.metrics_path is defined %}
    metrics_path: "{{ job.metrics_path }}"
{% endif %}
{% if job.basic_auth | default(false) %}
    basic_auth:
      username: "{{ metrics_user }}"
      password_file: /etc/prometheus/secrets/metrics_password
{% endif %}
    static_configs:
      - targets: {{ job.targets | to_json }}
{% endfor %}